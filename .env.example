REACT_APP_SUPABASE_URL=https://你的-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=你的-anon-public-key
# Optional stable HTTPS backend; temporary URLs can be confirmed per browser
# tab in the assistant's AI connection settings.
REACT_APP_CLINICAL_API_BASE_URL=

# Frontend port (React reads PORT); keep it different from the API.
PORT=3000
CLINICAL_API_PORT=3001

# Clinical API settings; credentials belong in .env.rag (see .env.rag.example).
# Do not duplicate backend credentials here: .env is loaded first without override.
# CRA development proxy rewrites Origin to http://localhost:3001.
# Production should list only the deployed HTTPS origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-production-domain.example
CLINICAL_API_REQUEST_LIMIT=256kb
CLINICAL_API_RATE_WINDOW_MS=60000
CLINICAL_API_RATE_MAX=20
