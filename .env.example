REACT_APP_SUPABASE_URL=https://你的-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=你的-anon-public-key

# Clinical API settings; credentials belong in .env.rag (see .env.rag.example).
# Do not duplicate backend credentials here: .env is loaded first without override.
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.example
CLINICAL_API_REQUEST_LIMIT=256kb
CLINICAL_API_RATE_WINDOW_MS=60000
CLINICAL_API_RATE_MAX=20
