# Backend and local import tools only. Copy to .env.rag and fill placeholders.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
HUGGINGFACE_EMBEDDING_MODEL=Xenova/multilingual-e5-small
HUGGINGFACE_CACHE_DIR=./.cache/huggingface
HUGGINGFACE_CACHE_PATH=./.cache/huggingface
KNOWLEDGE_BASE_PATH=./knowledge_base
IMPORT_MODE=all
IMPORT_LIMIT=239
# Search-script settings; do not change the API's built-in thresholds.
RAG_MATCH_THRESHOLD=0.5
RAG_MATCH_COUNT=8
